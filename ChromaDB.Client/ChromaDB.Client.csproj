<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<!-- The analyzers of trimming and NativeAOT run on the target that has them. -->
		<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
		<VersionPrefix>2.13.0</VersionPrefix>
		<PackageId>ChromaDB.Client</PackageId>
		<!-- -p:PackageIdPrefix=Name publishes the package as Name.Client. -->
		<PackageId Condition="'$(PackageIdPrefix)' != ''">$(PackageIdPrefix).Client</PackageId>
		<Authors>ssone95, cincuranet, ChromaDotNet contributors</Authors>
		<PackageDescription>.NET client for Chroma and Chroma Cloud, tested with Chroma 0.4.10 to 1.5.9. Community project, not affiliated with Chroma.</PackageDescription>
		<PackageTags>chroma chromadb vector-database chroma-cloud ai embeddings rag</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- The logo of ChromaDotNet goes only in the packages published with -p:PackageIdPrefix. -->
		<PackageIcon Condition="'$(PackageIdPrefix)' != ''">icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/ssone95/ChromaDB.Client</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ssone95/ChromaDB.Client</PackageProjectUrl>
		<!-- In GitHub Actions the links point to the repository that builds the package. -->
		<RepositoryUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</RepositoryUrl>
		<PackageProjectUrl Condition="'$(GITHUB_REPOSITORY)' != ''">https://github.com/$(GITHUB_REPOSITORY)</PackageProjectUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<!-- The XML documentation of the public API goes in the package, for IntelliSense. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReleaseNotes>2.13.0: UpdateAsync and UpsertAsync delete metadata keys and documents without reading the records first, so two writes of the same record at the same time leave the record of one of them. A collection client chooses once how NullDocumentsDelete deletes a document: WithDocumentCopyKey, or the new WithDocumentDeletionKey and WithEmptyDocumentDeletions; without one, a null document with NullDocumentsDelete throws an ArgumentException, and another way or key throws an InvalidOperationException. On Chroma Cloud, a write with nulls beyond the quota of 32 metadata keys throws an ArgumentException, unless ChromaConfigurationOptions.WithReadsBeyondKeyQuota, and so does a filter on the documents that Chroma Cloud answers with the wrong records: a $regex whose pattern takes an empty text, and a $contains of fewer than 3 characters. An empty text gets an empty BM25 vector. All the releases: $(PackageProjectUrl)/releases. Tested versions: $(PackageProjectUrl)/blob/main/docs/COMPATIBILITY.md. Migration from 1.x: $(PackageProjectUrl)#migrating-from-chromadbclient-1x</PackageReleaseNotes>
	</PropertyGroup>
	<ItemGroup>
		<!-- The public API, checked at build: PublicAPI.Shipped.txt is the API of the last release, PublicAPI.Unshipped.txt what was
		     added since. RS0026 and RS0027 are about overloads with optional parameters, the design the API already has. -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\assets\chromadotnet-icon.png" Pack="true" PackagePath="\icon.png" Condition="'$(PackageIdPrefix)' != ''" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0' Or '$(TargetFramework)'=='net462'">
		<PackageReference Include="PolySharp" Version="1.14.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<!-- The netstandard2.0 build is the one of .NET Core 3.1 to 7: the 8.0 packages have builds for .NET 6 and 7, and no
	     warning there, as 2.7.1. ActivitySource and Meter are in the runtime from .NET 5. -->
	<ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
		<PackageReference Include="System.Memory" Version="4.5.5" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
		<PackageReference Include="System.Text.Json" Version="8.0.6" />
	</ItemGroup>
	<!-- .NET 8: InstrumentAdvice, for the bucket boundaries of db.client.operation.duration, is in DiagnosticSource 9 and later,
	     which OpenTelemetry 1.10 and later bring too. -->
	<ItemGroup Condition="'$(TargetFramework)'=='net8.0'">
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.20" />
	</ItemGroup>
	<!-- .NET Framework: the versions OpenTelemetry 1.19 brings, so that the two load without binding redirects. -->
	<ItemGroup Condition="'$(TargetFramework)'=='net462'">
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
		<PackageReference Include="System.Text.Json" Version="10.0.12" />
		<Reference Include="System.Net.Http" />
		<!-- The implicit usings of .NET Framework do not have it. -->
		<Using Include="System.Net.Http" />
	</ItemGroup>
</Project>
